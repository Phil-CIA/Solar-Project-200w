CONFIG_IDF_TARGET="esp32c3"
# Console on UART0 (GPIO21 TX -> STM32 PB11 relay) so boot logs survive EN resets;
# USB Serial/JTAG (COM9) keeps a mirrored copy of the output.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL=3
# Wi-Fi supervisor runs forever in the main task (scan, AP config, logging).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
